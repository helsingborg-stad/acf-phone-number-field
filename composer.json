{
    "name": "helsingborg-stad/acf-phone-number-field",
    "description": "International phone number field for Advanced Custom Fields.",
    "type": "wordpress-muplugin",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "giggsey/libphonenumber-for-php-lite": "^9.0"
    },
    "require-dev": {
        "carthage-software/mago": "1.59.0",
        "phpunit/phpunit": "~9.6.0",
        "yoast/phpunit-polyfills": "^1.1"
    },
    "autoload": {
        "psr-4": {
            "AcfPhoneNumberField\\": "source/php/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "AcfPhoneNumberField\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit --testsuite unit",
        "test:unit": "@test",
        "test:integration": [
            "@php vendor/bin/phpunit --configuration phpunit.wordpress.xml",
            "@php vendor/bin/phpunit --configuration phpunit.integration.xml"
        ],
        "test:all": [
            "@test:unit",
            "@test:integration"
        ],
        "lint": [
            "@php vendor/bin/mago lint",
            "@php vendor/bin/mago analyze"
        ],
        "format": "mago fmt",
        "setup:tests": "bash scripts/setup-tests.sh"
    },
    "config": {
        "allow-plugins": {
            "carthage-software/mago": true
        },
        "sort-packages": true
    }
}
